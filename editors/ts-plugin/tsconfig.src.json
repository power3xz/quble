{
  // 루트 설정을 그대로 쓰되 모듈 형식만 CJS로 덮는다 - tsserver는 plugin을 require로 싣고
  // module.exports가 함수 자체이길 기대한다(`export =`). ESM으로 내면 { default: fn }이 되어
  // tsserver가 못 찾는다.
  "extends": "../../tsconfig.json",
  // 해석 규칙(moduleResolution)은 루트 그대로 bundler다 - 실제로 esbuild가 번들한다.
  "compilerOptions": {
    "module": "CommonJS"
  },
  // plugin 본체만. 그 옆의 테스트와 검사 스크립트는 Node가 ESM으로 직접 실행하므로 이 설정
  // (CJS)으로 보면 import.meta가 걸린다 - tsconfig.test.json이 그쪽을 맡는다.
  "include": ["src/**/*.ts"]
}
