{
  // 테스트와 검사 스크립트. plugin 본체(tsconfig.json)와 갈라 두는 이유는 실행 형식이 달라서다 -
  // 본체는 tsserver가 require로 싣는 CJS 번들이 되지만, 이쪽은 Node가 ESM으로 직접 실행한다.
  // 한 설정으로 덮으면 import.meta가 CJS에서 막힌다.
  //
  // 루트 설정(ESM)을 그대로 쓴다 - 덮을 것이 없다.
  "extends": "../../tsconfig.json",
  "include": ["*.test.ts", "typecheck-handlers.ts"]
}
