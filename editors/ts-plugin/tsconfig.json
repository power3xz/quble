{
  // 이 디렉터리는 실행 형식이 둘로 갈려 설정을 하나로 둘 수 없다 - plugin 본체는 tsserver가
  // require로 싣는 CJS 번들이 되고, 테스트와 검사 스크립트는 Node가 ESM으로 직접 실행한다.
  // 한 설정으로 덮으면 import.meta가 CJS에서 막힌다.
  //
  // 그래서 이 파일은 파일을 담지 않고 둘을 가리키기만 한다. 편집기(tsserver)는 파일에서 위로
  // 올라가며 tsconfig.json을 찾으므로, 이것이 있어야 references를 따라 양쪽을 모두 인지한다 -
  // 이름이 다른 설정(tsconfig.*.json)은 저절로 찾지 않는다.
  "files": [],
  "references": [{ "path": "./tsconfig.src.json" }, { "path": "./tsconfig.test.json" }]
}
