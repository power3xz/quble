{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Quble",
  "scopeName": "source.quble",
  "patterns": [
    { "include": "#comment" },
    { "include": "#use" },
    { "include": "#component" },
    { "include": "#block-keyword" },
    { "include": "#directive" },
    { "include": "#of" },
    { "include": "#type-key" },
    { "include": "#type" },
    { "include": "#event-name" },
    { "include": "#composition" },
    { "include": "#tag" },
    { "include": "#attribute" },
    { "include": "#interpolation" },
    { "include": "#string" }
  ],
  "repository": {
    "comment": {
      "comment": "// 줄 끝까지, /* */ 블록.",
      "patterns": [
        { "match": "//.*$", "name": "comment.line.double-slash.quble" },
        {
          "begin": "/\\*",
          "end": "\\*/",
          "name": "comment.block.quble"
        }
      ]
    },
    "use": {
      "comment": "use X, Y from \"path\" - 다른 소스의 컴포넌트 import.",
      "begin": "\\b(use)\\b",
      "beginCaptures": {
        "1": { "name": "keyword.control.use.quble" }
      },
      "end": "$",
      "patterns": [
        { "match": "\\b(from)\\b", "name": "keyword.control.use.quble" },
        { "include": "#string" },
        { "match": "[A-Za-z_][A-Za-z0-9_]*", "name": "entity.name.type.component.quble" }
      ]
    },
    "component": {
      "match": "\\b(component)\\s+([A-Z][A-Za-z0-9_]*)",
      "captures": {
        "1": { "name": "keyword.other.component.quble" },
        "2": { "name": "entity.name.type.component.quble" }
      }
    },
    "block-keyword": {
      "match": "\\b(props|contexts|events|template)\\b",
      "name": "keyword.other.block.quble"
    },
    "directive": {
      "comment": "구조(@if/@else/@for/@with/@slot)와 DOM 이벤트(@click 등). lexer.rs Directive::keyword와 같은 목록.",
      "match": "(@)(if|else|for|with|slot|click|input|change|submit|focus|blur|keydown|keyup|mousedown|mouseup|mouseenter|mouseleave|scroll)\\b",
      "name": "keyword.control.directive.quble"
    },
    "type": {
      "comment": "원시 3종과 유틸 타입. 배열/객체는 문법 기호라 여기 없다.",
      "match": "\\b(string|number|bool|Omit|Pick)\\b",
      "name": "support.type.quble"
    },
    "type-key": {
      "comment": "작은따옴표 타입 키 - Omit<Section, 'title'>. 큰따옴표(값 리터럴)와 자리가 다르다.",
      "match": "'[^'\\n]*'",
      "name": "string.quoted.single.quble"
    },
    "of": {
      "comment": "@for (x of y)의 of.",
      "match": "\\b(of)\\b",
      "name": "keyword.control.of.quble"
    },
    "composition": {
      "comment": "Alias: Comp(...) 또는 Comp(...) - 대문자 식별자. 별칭이 있으면 별칭이 경로 마디.",
      "patterns": [
        {
          "match": "\\b([A-Z][A-Za-z0-9_]*)\\s*(:)\\s*([A-Z][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "entity.name.tag.alias.quble" },
            "2": { "name": "punctuation.separator.alias.quble" },
            "3": { "name": "entity.name.type.component.quble" }
          }
        },
        {
          "match": "\\b([A-Z][A-Za-z0-9_]*)(?=\\s*\\()",
          "name": "entity.name.type.component.quble"
        }
      ]
    },
    "event-name": {
      "comment": "대문자 스네이크 관례 - TOGGLE, CLICK_STAT. @click:EVENT 및 events 블록 선언.",
      "match": "\\b([A-Z][A-Z0-9_]*)\\b",
      "name": "constant.other.event.quble"
    },
    "tag": {
      "comment": "div(...) 같은 요소. 앞에 @가 붙은 것은 디렉티브라 뺀다(@for (x of y)의 for).",
      "match": "(?<!@)\\b([a-z][a-zA-Z0-9-]*)(?=\\s*\\()",
      "name": "entity.name.tag.quble"
    },
    "attribute": {
      "match": "\\b([a-zA-Z_][a-zA-Z0-9_-]*)\\s*(=)",
      "captures": {
        "1": { "name": "entity.other.attribute-name.quble" },
        "2": { "name": "keyword.operator.assignment.quble" }
      }
    },
    "interpolation": {
      "comment": "{var} 보간 - 단일 prop 참조만(표현식 미구현). 블록 본문의 `{`와 구별하려고 `{ 식별자 }` 한 덩어리만 매칭한다(begin/end로 열면 블록 `{`를 삼킨다).",
      "match": "(\\{)\\s*([A-Za-z_][A-Za-z0-9_]*)\\s*(\\})",
      "captures": {
        "1": { "name": "punctuation.section.embedded.begin.quble" },
        "2": { "name": "variable.other.quble" },
        "3": { "name": "punctuation.section.embedded.end.quble" }
      }
    },
    "string": {
      "comment": "문자열 안 {var} 보간 허용.",
      "begin": "\"",
      "end": "\"",
      "name": "string.quoted.double.quble",
      "patterns": [
        {
          "match": "(\\{)\\s*([A-Za-z_][A-Za-z0-9_]*)\\s*(\\})",
          "captures": {
            "1": { "name": "punctuation.section.embedded.begin.quble" },
            "2": { "name": "variable.other.quble" },
            "3": { "name": "punctuation.section.embedded.end.quble" }
          }
        }
      ]
    }
  }
}
