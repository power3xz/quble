{
  // 이 실험은 자기 node_modules(react)를 갖는다. 루트 tsconfig는 experiments를 보지 않고, 여기서 따로 본다.
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "types": ["node"],
    "jsx": "react-jsx",
    "paths": { "quble/react": ["./adapter/react-browser.ts"] },
    "strict": true,
    "noEmit": true
  },
  "include": ["runtime/**/*.ts", "adapter/**/*.ts", "adapter/**/*.tsx"],
  // demo-next는 자기 tsconfig를 갖고 next build가 직접 타입 검사한다(Next의 타입이 이 설정의 lib와 안 맞는다).
  "exclude": ["adapter/demo-next"]
}
