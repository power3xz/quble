{
  // 이 실험은 자기 node_modules(jsdom, vite)를 갖는다. 루트 tsconfig는 experiments를 보지 않고, 여기서 따로 본다.
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    // 데모가 vite의 ?raw import를 쓴다.
    "types": ["node", "vite/client"],
    "strict": true,
    "noEmit": true
  },
  "include": ["*.ts", "demo/src/*.ts"]
}
