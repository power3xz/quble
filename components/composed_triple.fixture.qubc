use InnerPair from "./inner_pair.fixture.qubc"

component ComposedTriple {
  props { c1: bool, c2: bool, c3: bool, a: string, b: string, c: string, d: string }
  template {
    div() {
      @if (c1) {
        InnerPair(c2={c2} c3={c3} a={a} b={b} c={c}) {}
      }
      @else {
        p() { {d} }
      }
    }
  }
}
