use "./profilecard.css"
use Thumbnail from "./thumbnail.qubc"
use Badge from "./badge.qubc"
use Stat from "./stat.qubc"
use MetaRow from "./metarow.qubc"
use Activity from "./activity.qubc"
use Tag from "./tag.qubc"
use LinkButton from "./linkbutton.qubc"

component ProfileCard {
  props {
    name: string, role: string, bio: string, avatar: string, link: string, theme: string,
    stats: { label: string, value: string }[],
    meta: { icon: string, text: string }[],
    activities: { icon: string, text: string, time: string }[],
    tags: string[],
    links: string[]
  }
  template {
    article(class={theme}) {
      div(class="header") {
        Thumbnail(avatar={avatar} name={name} /)
        div(class="ident") {
          h3(class="name") { {name} }
          Badge(role={role} theme={theme} /)
        }
      }
      p(class="bio") { {bio} }
      div(class="stats") {
        @for (stat of stats) {
          Stat(label={stat.label} value={stat.value} /)
        }
      }
      div(class="meta") {
        @for (row of meta) {
          MetaRow(icon={row.icon} text={row.text} /)
        }
      }
      div(class="activity") {
        @for (act of activities) {
          Activity(icon={act.icon} text={act.text} time={act.time} /)
        }
      }
      div(class="tags") {
        @for (tag of tags) {
          Tag(text={tag} theme={theme} /)
        }
      }
      div(class="links") {
        @for (url of links) {
          LinkButton(link={url} theme={theme} /)
        }
      }
      a(class="profile" href={link}) { "전체 프로필 보기" }
    }
  }
}
