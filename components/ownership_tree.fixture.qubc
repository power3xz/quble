component OwnershipTree {
  props { n: number, limit: number, rate: number, rows: number[] }
  events { DEL({ rows }) }
  template {
    div() {
      button(class="del" @click:DEL) { "-" }
      @for (i of n) {
        @if (i < limit) {
          span() { ${i * rate} }
        } @else {
          span() { ${rate + 1} }
        }
      }
      @for (row of rows) {
        @if (row > limit) {
          span() { ${rate * 2} }
        }
      }
    }
  }
}
