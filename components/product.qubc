component ProductCard {
  props { name: string, price: string }
  template {
    div(class="card") {
      h3(class="name") { {name} }
      PriceTag(price={price} /)
      BuyButton(price={price} /)
    }
  }
}

component PriceTag {
  props { price: string }
  template {
    span(class="badge") { {price} "원" }
  }
}

component BuyButton {
  props { price: string }
  template {
    button(class="buy") { {price} "원 담기" }
  }
}
