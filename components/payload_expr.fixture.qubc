component PayloadExpr {
  props {
    n: number,
    open: bool,
    cursor: number,
    rows: { title: string, tags: string[] }[]
  }
  contexts {
    Area {
      closed: !open,
      next: n + 1,
      row: rows[cursor],
      title: rows[cursor].title,
      tags: rows[cursor].tags,
      count: rows.length
    }
  }
  events {
    SEND({
      next: n + 1,
      row: rows[cursor],
      title: rows[cursor].title,
      tags: rows[cursor].tags,
      count: rows.length
    })
    PING({})
  }
  template {
    div() {
      @with Area {
        button(class="send" @click:SEND) { "send" }
        button(class="ping" @click:PING) { "ping" }
      }
      @for (_, i of 3) {
        Pick(num={i} /)
      }
      @for (r, i of rows) {
        Item: RowItem(rows={rows} at={i} /)
      }
    }
  }
}

component RowItem {
  props { rows: { title: string, tags: string[] }[], at: number }
  contexts { Cell { row: rows[at] } }
  events {
    TAKE({ row: rows[at] })
    DROP({})
  }
  template {
    div() {
      @with Cell {
        button(class="take" @click:TAKE) { "take" }
      }
      button(class="drop" @click:DROP) { "drop" }
    }
  }
}

component Pick {
  props { num: number }
  contexts { Slot { next: num + 1 } }
  events { PICK({ next: num + 1 }) }
  template {
    @with Slot {
      button(class="pick" @click:PICK) { ${num} }
    }
  }
}
