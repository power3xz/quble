component NumList {
  props { nums: number[] }
  events {
    ADD({ nums })
    DEL({ nums })
  }
  template {
    div(class="numlist") {
      button(class="add" @click:ADD) { "+" }
      button(class="del" @click:DEL) { "-" }
      ul() {
        @for (n of nums) {
          li(class="num" title={n + 1}) { ${n * 2} }
        }
      }
    }
  }
}
