use "./settings.css"
use SettingRow from "./settingrow.qubc"

component Section {
  props {
    title: string, open: bool,
    a: SettingRow, b: SettingRow
  }
  contexts {
    SectionMeta { section: title }
  }
  events {
    TOGGLE_SECTION({ title, open })
  }
  template {
    section(class="section") {
      header(class="section__head" @click:TOGGLE_SECTION) {
        h2(class="section__title") { {title} }
        @if (open) {
          span(class="section__chevron section__chevron--open") { "접기" }
        } @else {
          span(class="section__chevron") { "펼치기" }
        }
      }
      @if (open) {
        @with SectionMeta {
          div(class="section__body") {
            FirstRow: SettingRow(label={a.label} desc={a.desc} badge={a.badge} enabled={a.enabled} /)
            SecondRow: SettingRow(label={b.label} desc={b.desc} badge={b.badge} enabled={b.enabled} /)
          }
        }
      }
    }
  }
}
