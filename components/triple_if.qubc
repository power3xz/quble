component TripleIf {
  props { c1: bool, c2: bool, c3: bool, a: string, b: string, c: string, d: string }
  template {
    div() {
      @if (c1) {
        @if (c2) {
          @if (c3) {
            p() { {a} }
          }
          @else {
            p() { {b} }
          }
        }
        @else {
          p() { {c} }
        }
      }
      @else {
        p() { {d} }
      }
    }
  }
}
