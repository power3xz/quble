component ExprArrayIndex {
  props {
    rows: { title: string, score: number }[],
    scalars: number[],
    cursor: number,
    show: bool
  }
  events {
    REMOVE_FIRST_ROW({})
    REMOVE_FIRST_SCALAR({})
    SET_ONE_ROW({})
  }
  template {
    div() {
      button(class="remove-first-row" @click:REMOVE_FIRST_ROW) { "remove row" }
      button(class="remove-first-scalar" @click:REMOVE_FIRST_SCALAR) { "remove scalar" }
      button(class="set-one-row" @click:SET_ONE_ROW) { "set one row" }
      p(class="field") { ${rows[cursor].title} }
      p(class="scalar") { ${scalars[cursor]} }
      p(class="arith") { ${rows[cursor].score * 2} }
      p(class="two") { ${rows[0].score + rows[1].score} }
      p(class="shifted") { ${rows[cursor + 1].title} }
      span(id={rows[cursor].title}) { "attr" }
      p(class="alias") { ${rows[cursor].score + rows[0].score} }
      @if (show) {
        p(class="shown") { ${rows[cursor].title} }
      }
      @if (rows[cursor].score > 15) {
        p(class="high") { "high" }
      }
    }
  }
}
