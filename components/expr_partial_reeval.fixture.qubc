use ExprPartialReevalPair from "./expr_partial_reeval_pair.fixture.qubc"

component ExprPartialReeval {
  props {
    a: number,
    b: number,
    c: number,
    d: number,
    rows: { score: number }[],
    cursor: number,
    x: number,
    shared: number,
    z: number,
    show: bool,
    big: number
  }
  template {
    div() {
      p(class="arith") { ${(a + b) * (c - d)} }
      p(class="index") { ${rows[cursor].score + x} }
      ExprPartialReevalPair(p={shared} q={shared} z={z} /)
      p(class="flag") { ${big > 50} }
      @if (show) {
        p(class="shown") { ${(a + b) * (c - d)} }
      }
    }
  }
}
