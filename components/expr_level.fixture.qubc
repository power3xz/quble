component ExprLevel {
  props { a: number, b: number, rows: { base: number, cells: number[] }[] }
  template {
    div() {
      p(class="top") { ${a * b} }
      @for (row of rows) {
        p(class="row") { ${row.base + a} }
        @for (cell of row.cells) {
          span(class="cell") { ${cell * a} }
          span(class="outer") { ${row.base * 2} }
          span(class="props") { ${a + 1} }
        }
      }
    }
  }
}
