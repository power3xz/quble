component RowList {
  props { rows: { label: string, cells: string[] }[] }
  events {
    REPLACE({ rows })
    PICK({ rows })
  }
  template {
    div(class="rowlist") {
      button(class="replace" @click:REPLACE) { "=" }
      ul() {
        @for (row, i of rows) {
          li(class="row") {
            span(class="idx") { {i} }
            span(class="label") { {row.label} }
            button(class="pick" @click:PICK) { "p" }
            @for (cell of row.cells) {
              span(class="cell") { {cell} }
            }
          }
        }
      }
    }
  }
}
