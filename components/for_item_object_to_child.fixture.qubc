component List {
  props { items: { tag: string, detail: { label: string, value: string } }[] }
  template {
    div(class="list") {
      @for (item of items) {
        Card(info={item.detail}) {}
      }
    }
  }
}

component Card {
  props { info: { label: string, value: string } }
  template {
    div(class="card") {
      span(class="label") { {info.label} }
      span(class="value") { {info.value} }
    }
  }
}
