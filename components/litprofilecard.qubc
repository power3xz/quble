use "./profilecard.css"
use Thumbnail from "./thumbnail.qubc"
use Badge from "./badge.qubc"
use Stat from "./stat.qubc"
use MetaRow from "./metarow.qubc"
use Activity from "./activity.qubc"
use Tag from "./tag.qubc"
use LinkButton from "./linkbutton.qubc"

component LitProfileCard {
  props {
    name: string, role: string, bio: string, avatar: string, link: string,
    followersLabel: string, followers: string, followingLabel: string, following: string, postsLabel: string, posts: string,
    location: string, company: string,
    site: string, github: string, twitter: string,
    act1Text: string, act1Time: string, act2Text: string, act2Time: string, act3Text: string, act3Time: string,
    tag1: string, tag2: string, tag3: string, tag4: string
  }
  contexts {
    HoverArea { title: "dude", twitter }
    PremiumStat { adId: "AD-001", type: "Twinkle" }
  }
  events {
    HOVER({ name })
    LEAVE({ name })
    OPEN_PROFILE({ name, link })
    BIO_SCROLL({ name })
  }
  template {
    @with HoverArea {
      article(class="light" @mouseenter:HOVER @mouseleave:LEAVE) {
        div(class="header") {
          MainThumb: Thumbnail(avatar={avatar} name={name}) {}
          div(class="ident") {
            h3(class="name") { {name} }
            Badge(role={role} theme="light") {}
          }
        }
        p(class="bio" @scroll:BIO_SCROLL) { {bio} }
        div(class="stats") {
          @with PremiumStat {
            FirstStat: Stat(label={followersLabel} value={followers}) {}
          }
          SecondStat: Stat(label={followingLabel} value={following}) {}
          ThirdStat: Stat(label={postsLabel} value={posts}) {}
        }
        div(class="meta") {
          MetaRow(icon="📍" text={location}) {}
          MetaRow(icon="🏢" text={company}) {}
        }
        div(class="activity") {
          Activity(icon="✏️" text={act1Text} time={act1Time}) {}
          Activity(icon="⭐" text={act2Text} time={act2Time}) {}
          Activity(icon="🔔" text={act3Text} time={act3Time}) {}
        }
        div(class="tags") {
          Tag(text={tag1} theme="light") {}
          Tag(text={tag2} theme="light") {}
          Tag(text={tag3} theme="light") {}
          Tag(text={tag4} theme="light") {}
        }
        div(class="links") {
          LinkButton(link={site} theme="light") {}
          LinkButton(link={github} theme="light") {}
          LinkButton(link={twitter} theme="light") {}
        }
        a(class="profile" href={link} @click:OPEN_PROFILE) { "전체 프로필 보기" }
      }
    }
  }
}
