component SiblingIf {
  props { c1: bool, c2: bool, a: string, b: string, c: string, d: string }
  template {
    div() {
      @if (c1) {
        p() { {a} }
      }
      @else {
        p() { {b} }
      }
      @if (c2) {
        p() { {c} }
      }
      @else {
        p() { {d} }
      }
    }
  }
}
