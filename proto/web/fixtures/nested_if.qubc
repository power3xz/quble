component NestedIf {
  props { outer: bool, inner: bool, a: string, b: string, c: string }
  template {
    div() {
      @if (outer) {
        p() { {a} }
        @if (inner) {
          p() { {b} }
        }
        @else {
          p() { {c} }
        }
      }
      @else {
        p() { {a} }
      }
    }
  }
}
