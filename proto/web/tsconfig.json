{
  "compilerOptions": {
    // Node 22 --experimental-strip-types로 실행 - 트랜스파일 없이 .ts를 그대로 돌리므로
    // target/module도 Node가 이해하는 최신 ESM 그대로 맞춘다.
    "target": "ES2022",
    "module": "ES2022",
    // esbuild(build.mjs)가 번들러 역할 - Node 네이티브 실행과 동일한 해석 규칙을 쓰는
    // "bundler" 모드가 둘 다와 맞는다(확장자 없는 import, package.json exports 등).
    "moduleResolution": "bundler",
    // Node 네이티브 실행이 상대 import에 실제 확장자(.ts)를 요구하므로 tsc도 그 표기를 허용.
    "allowImportingTsExtensions": true,
    // Node 내장 모듈(node:test/node:assert 등) 타입. @types/node로 제공. .ts 테스트가 참조한다.
    "types": ["node"],
    // 신규 .ts 전환분이라 처음부터 strict로 - any 누수 없이 타입을 확실히 잡는다.
    "strict": true,
    // runtime.js 등 아직 안 옮긴 .js를 .ts에서 import하므로, tsc가 그 .js를 읽어(암묵적
    // any로) 타입 없다는 에러 없이 넘어가게 한다. 전환이 끝나면 제거 대상.
    "allowJs": true,
    // tsc는 타입체크 전용(noEmit) - 실제 실행은 Node의 타입 스트리핑이, 배포용 번들은
    // esbuild가 담당하므로 tsc가 산출물을 낼 필요가 없다.
    "noEmit": true
  },
  "include": ["**/*.ts", "**/*.js"],
  "exclude": ["node_modules"]
}
