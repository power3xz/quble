use "./forstress.css"

component Depth1 {
  template {
    div(class="stress") {
      h1() { "quble @for 부하: 10 x 100 x 100 = 100,000 카드" }
      @for (a of 10) {
        Row: Depth2() {}
      }
    }
  }
}

component Depth2 {
  template {
    @for (b of 100) {
      Col: Depth3() {}
    }
  }
}

component Depth3 {
  template {
    @for (c of 100) {
      Card: ProfileCard() {}
    }
  }
}

component ProfileCard {
  events { PICK({ label: "card" }) }
  template {
    div(class="card" @click:PICK) {
      div(class="card__name") { "Jane Doe" }
      div(class="card__job") { "Engineer" }
      div(class="card__loc") { "Seoul" }
    }
  }
}
