use "./settings.css"
use Section from "./section.qubc"
use Badge from "./badge.qubc"
use LinkButton from "./linkbutton.qubc"

component SettingsPanel {
  props {
    heading: string, dirty: bool, plan: string, docsLink: string,
    general: {
      open: bool,
      a: { title: string, desc: string, badge: string, on: bool },
      b: { title: string, desc: string, badge: string, on: bool }
    },
    privacy: {
      open: bool,
      a: { title: string, desc: string, badge: string, on: bool },
      b: { title: string, desc: string, badge: string, on: bool }
    },
    premium: {
      open: bool,
      a: { title: string, desc: string, badge: string, on: bool },
      b: { title: string, desc: string, badge: string, on: bool }
    }
  }
  contexts {
    PlanContext { plan }
  }
  events {
    SAVE({ heading })
    DISCARD({ heading })
  }
  template {
    div(class="panel") {
      header(class="panel__head") {
        h1(class="panel__title") { {heading} }
        div(class="panel__actions") {
          @if (dirty) {
            button(class="btn btn--ghost" @click:DISCARD) { "되돌리기" }
            button(class="btn btn--primary" @click:SAVE) { "저장" }
          } @else {
            span(class="panel__saved") { "저장됨" }
          }
        }
      }

      General: Section(
        title="일반" open={general.open}
        aLabel={general.a.title} aDesc={general.a.desc} aBadge={general.a.badge} aEnabled={general.a.on}
        bLabel={general.b.title} bDesc={general.b.desc} bBadge={general.b.badge} bEnabled={general.b.on}
      ) {}

      Privacy: Section(
        title="개인정보" open={privacy.open}
        aLabel={privacy.a.title} aDesc={privacy.a.desc} aBadge={privacy.a.badge} aEnabled={privacy.a.on}
        bLabel={privacy.b.title} bDesc={privacy.b.desc} bBadge={privacy.b.badge} bEnabled={privacy.b.on}
      ) {}

      @with PlanContext {
        div(class="panel__premium") {
          div(class="panel__premium-head") {
            h2(class="panel__premium-title") { "프리미엄" }
            Badge(role={plan} theme="badge--pro") {}
          }
          Premium: Section(
            title="프리미엄 기능" open={premium.open}
            aLabel={premium.a.title} aDesc={premium.a.desc} aBadge={premium.a.badge} aEnabled={premium.a.on}
            bLabel={premium.b.title} bDesc={premium.b.desc} bBadge={premium.b.badge} bEnabled={premium.b.on}
          ) {}
        }
      }

      footer(class="panel__foot") {
        LinkButton(link={docsLink} theme="btn--link") {}
      }
    }
  }
}
