use "./settings.css"
use Section from "./section.qubc"
use Badge from "./badge.qubc"
use LinkButton from "./linkbutton.qubc"

component SettingsPanel {
  props {
    heading: string, dirty: bool, plan: string, docsLink: string,
    general: Omit<Section, 'title'>,
    privacy: Omit<Section, 'title'>,
    premium: Omit<Section, 'title'>
  }
  contexts {
    PlanContext { plan }
  }
  events {
    SAVE({ heading })
    DISCARD({ heading })
  }
  template {
    div(class="panel") {
      header(class="panel__head") {
        h1(class="panel__title") { {heading} }
        div(class="panel__actions") {
          @if (dirty) {
            button(class="btn btn--ghost" @click:DISCARD) { "되돌리기" }
            button(class="btn btn--primary" @click:SAVE) { "저장" }
          } @else {
            span(class="panel__saved") { "저장됨" }
          }
        }
      }

      General: Section(
        title="일반" open={general.open}
        aLabel={general.aLabel} aDesc={general.aDesc} aBadge={general.aBadge} aEnabled={general.aEnabled}
        bLabel={general.bLabel} bDesc={general.bDesc} bBadge={general.bBadge} bEnabled={general.bEnabled}
      ) {}

      Privacy: Section(
        title="개인정보" open={privacy.open}
        aLabel={privacy.aLabel} aDesc={privacy.aDesc} aBadge={privacy.aBadge} aEnabled={privacy.aEnabled}
        bLabel={privacy.bLabel} bDesc={privacy.bDesc} bBadge={privacy.bBadge} bEnabled={privacy.bEnabled}
      ) {}

      @with PlanContext {
        div(class="panel__premium") {
          div(class="panel__premium-head") {
            h2(class="panel__premium-title") { "프리미엄" }
            Badge(role={plan} theme="badge--pro") {}
          }
          Premium: Section(
            title="프리미엄 기능" open={premium.open}
            aLabel={premium.aLabel} aDesc={premium.aDesc} aBadge={premium.aBadge} aEnabled={premium.aEnabled}
            bLabel={premium.bLabel} bDesc={premium.bDesc} bBadge={premium.bBadge} bEnabled={premium.bEnabled}
          ) {}
        }
      }

      footer(class="panel__foot") {
        LinkButton(link={docsLink} theme="btn--link") {}
      }
    }
  }
}
