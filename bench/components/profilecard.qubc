use "./profilecard.css"
use Thumbnail from "./thumbnail.qubc"
use Badge from "./badge.qubc"
use Stat from "./stat.qubc"
use MetaRow from "./metarow.qubc"
use Activity from "./activity.qubc"
use Tag from "./tag.qubc"
use LinkButton from "./linkbutton.qubc"

component ProfileCard {
  props {
    name: string, role: string, bio: string, avatar: string, link: string, theme: string,
    followersLabel: string, followers: string, followingLabel: string, following: string, postsLabel: string, posts: string,
    locationIcon: string, location: string, companyIcon: string, company: string,
    site: string, github: string, twitter: string,
    act1Icon: string, act1Text: string, act1Time: string, act2Icon: string, act2Text: string, act2Time: string, act3Icon: string, act3Text: string, act3Time: string,
    tag1: string, tag2: string, tag3: string, tag4: string
  }
  template {
    article(class={theme}) {
      div(class="header") {
        Thumbnail(avatar={avatar} name={name}) {}
        div(class="ident") {
          h3(class="name") { {name} }
          Badge(role={role} theme={theme}) {}
        }
      }
      p(class="bio") { {bio} }
      div(class="stats") {
        Stat(label={followersLabel} value={followers}) {}
        Stat(label={followingLabel} value={following}) {}
        Stat(label={postsLabel} value={posts}) {}
      }
      div(class="meta") {
        MetaRow(icon={locationIcon} text={location}) {}
        MetaRow(icon={companyIcon} text={company}) {}
      }
      div(class="activity") {
        Activity(icon={act1Icon} text={act1Text} time={act1Time}) {}
        Activity(icon={act2Icon} text={act2Text} time={act2Time}) {}
        Activity(icon={act3Icon} text={act3Text} time={act3Time}) {}
      }
      div(class="tags") {
        Tag(text={tag1} theme={theme}) {}
        Tag(text={tag2} theme={theme}) {}
        Tag(text={tag3} theme={theme}) {}
        Tag(text={tag4} theme={theme}) {}
      }
      div(class="links") {
        LinkButton(link={site} theme={theme}) {}
        LinkButton(link={github} theme={theme}) {}
        LinkButton(link={twitter} theme={theme}) {}
      }
      a(class="profile" href={link}) { "전체 프로필 보기" }
    }
  }
}
