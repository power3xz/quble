use "./column.css"
use Card from "./card.qubc"

component Column {
  props {
    name: string,
    accent: string,
    position: number,
    cards: Omit<Card, 'seat'>[]
  }
  contexts {
    LaneArea { lane: name, position: position }
  }
  events {
    CLICK_ADD_CARD({ lane: name })
    CLICK_HEADING({ lane: name, position })
    CLICK_REMOVE_CARD({ lane: name })
    GRAB_FROM({ lane: name })
    DROP_AT_END({ lane: name })
  }
  template {
    div(class="column") {
      header(class="column__head" style={accent}) {
        h2(class="column__name" @click:CLICK_HEADING) { {name} }
      }

      @with LaneArea {
        div(class="column__cards" @mousedown:GRAB_FROM @mouseup:DROP_AT_END) {
          @for (card, seat of cards) {
            div(class="column__slot") {
              Ticket: Card(
                title={card.title}
                assignee={card.assignee}
                points={card.points}
                urgent={card.urgent}
                seat={seat}
              /)
              button(class="column__remove" @click:CLICK_REMOVE_CARD) { "x" }
            }
          }
        }
      }

      button(class="column__add" @click:CLICK_ADD_CARD) { "+ 카드" }
    }
  }
}
