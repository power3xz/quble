use "./board.css"
use Card from "./card.qubc"
use Column from "./column.qubc"

component Board {
  props {
    title: string,
    owner: string,
    columns: Omit<Column, 'position'>[],
    ghost: {
      isDragging: bool,
      style: string,
      title: string,
      assignee: string,
      points: string,
      urgent: bool
    }
  }
  contexts {
    BoardArea { board: title, owner: owner }
  }
  events {
    CLICK_ADD_COLUMN({ title })
    CLICK_REMOVE_COLUMN({ title })
  }
  template {
    section(class="board") {
      header(class="board__bar") {
        div(class="board__id") {
          h1(class="board__title") { {title} }
          span(class="board__owner") { {owner} }
        }
        button(class="board__add" @click:CLICK_ADD_COLUMN) { "+ 컬럼" }
      }

      @with BoardArea {
        div(class="board__columns") {
          @for (column, index of columns) {
            div(class="board__slot") {
              button(class="board__remove" @click:CLICK_REMOVE_COLUMN) { "컬럼 삭제" }
              Lane: Column(
                name={column.name}
                accent={column.accent}
                position={index}
                cards={column.cards}
              /)
            }
          }
        }
      }

      @if (ghost.isDragging) {
        div(class="ghost" style={ghost.style}) {
          Drag: Card(
            title={ghost.title}
            assignee={ghost.assignee}
            points={ghost.points}
            urgent={ghost.urgent}
            seat=0
          /)
        }
      }
    }
  }
}
